{
  "instrument_types": {
    "grant": {
      "description": "Non-repayable funding with no debt obligations",
      "debt_sensitivity": "tier_1",
      "characteristics": [
        "No repayment required",
        "No sovereign guarantee needed",
        "No interest payments",
        "Full ownership of funded assets"
      ]
    },
    "results_based_grant": {
      "description": "Grant paid upon achievement of verified results (e.g., connections)",
      "debt_sensitivity": "tier_1_or_2",
      "characteristics": [
        "Payment contingent on results",
        "May require bridge financing for implementation",
        "No repayment of funds received",
        "Typically per-unit payment (e.g., $/connection)"
      ],
      "considerations": [
        "Bridge financing creates temporary debt exposure",
        "Verify implementing entity can pre-finance"
      ]
    },
    "concessional_loan": {
      "description": "Loan with below-market interest rates and favorable terms",
      "debt_sensitivity": "tier_3_or_4",
      "characteristics": [
        "Requires repayment",
        "Below-market interest (typically <2%)",
        "Long grace periods (5+ years)",
        "May require sovereign guarantee"
      ],
      "considerations": [
        "Still adds to debt burden",
        "Creates future fiscal obligations",
        "May crowd out other spending"
      ]
    },
    "commercial_loan": {
      "description": "Market-rate loan",
      "debt_sensitivity": "tier_4",
      "characteristics": [
        "Market interest rates",
        "Standard repayment terms",
        "Full credit risk on borrower"
      ],
      "considerations": [
        "Not appropriate for community energy projects",
        "Significant debt burden"
      ]
    },
    "equity": {
      "description": "Ownership stake investment",
      "debt_sensitivity": "tier_2_or_3",
      "characteristics": [
        "No fixed repayment",
        "Share in profits/losses",
        "Investor has ownership rights"
      ],
      "considerations": [
        "May require government guarantees",
        "Profit extraction reduces local benefit",
        "Potential for capital flight"
      ]
    },
    "guarantee": {
      "description": "Risk mitigation instrument backing another financing source",
      "debt_sensitivity": "tier_3_or_4",
      "characteristics": [
        "Creates contingent liability",
        "Enables other financing",
        "May be called if project fails"
      ],
      "considerations": [
        "Sovereign guarantees treated as debt by IMF",
        "Hidden fiscal risk",
        "Can trigger debt distress"
      ]
    },
    "blended_grant_equity": {
      "description": "Combination of grant and equity components",
      "debt_sensitivity": "varies",
      "characteristics": [
        "Multiple instruments in single package",
        "Grant portion reduces overall risk",
        "Equity portion involves ownership dilution"
      ],
      "considerations": [
        "Evaluate each component separately",
        "Grant portion preferred",
        "Be cautious of equity terms"
      ]
    }
  },
