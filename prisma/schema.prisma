// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Invite codes for advisor registration
model Invite {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  code         String    @unique
  email        String?   // Optional: restrict to specific email
  createdBy    String    // Admin who created it
  expiresAt    DateTime?
  usedAt       DateTime?
  usedBy       String?   // Advisor ID who used it
  maxUses      Int       @default(1)
  useCount     Int       @default(0)
}

// Discovered grants (pending review)
model DiscoveredGrant {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Grant information
  funderName        String
  instrumentType    String?
  geographyFocus    String?  // JSON
  thematicFocus     String?  // JSON
  ticketSizeMin     Float?
  ticketSizeMax     Float?
  description       String
  website           String?
  sourceUrl         String?  // Where it was discovered

  // Discovery metadata
  discoveredBy      String   // "auto_search" or advisor ID
  searchQuery       String?  // What search found this
  confidence        Float?   // AI confidence score
  verificationStatus String  @default("unverified") // unverified, verified, rejected

  // Review status
  status            String   @default("pending") // pending, approved, rejected, duplicate
  reviewNotes       String?
  reviewedBy        String?  // Advisor ID who reviewed
  reviewedAt        DateTime?

  // If approved, the ID in the grants database
  approvedGrantId   String?
}

// Grant search history
model GrantSearch {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  query        String
  region       String?
  resultsCount Int
  status       String   @default("completed") // running, completed, failed
  error        String?
  triggeredBy  String?  // Advisor ID or "scheduled"
}

// Advisor accounts
model Advisor {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  email        String    @unique
  name         String
  organization String?
  passwordHash String
  role         String    @default("advisor") // advisor, admin
  projects     Project[]
  projectRevisions ProjectRevision[] @relation("ProjectRevisionCreatedBy")
}

// Project submission tracking
model Project {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Project intake data
  projectName         String
  country             String
  locationDescription String
  technologyType      String
  technologyOther     String?
  capacityKw          Float?
  targetBeneficiaries String
  ownershipModel      String
  ownershipOther      String?
  productiveUses      String   // JSON array stored as string
  estimatedCostUsd    Float
  existingFunding     String?
  projectStage        String
  communityEngagement String?
  additionalContext   String?
  contactInfo         String?  // JSON object stored as string
  debtPreference      String
  readinessEvidence   String?  // JSON object stored as string

  // Analysis results (stored as JSON strings)
  policyResult        String?  // PolicyInterpretation JSON
  grantsResult        String?  // GrantMatchResult JSON
  coachResult         String?  // ProposalCoach JSON
  tradeoffsResult     String?  // TradeOffExplorer JSON

  // Metadata
  m300Score           Int?
  debtTier            String?
  topFunder           String?
  topFunderScore      Int?
  enhanced            Boolean  @default(false)
  processingTimeMs    Int?

  // Tracking
  status              String   @default("submitted") // submitted, in_review, approved, needs_info, archived
  advisorNotes        String?
  currentRevision     Int      @default(1)

  // Advisor relationship
  advisorId           String?
  advisor             Advisor? @relation(fields: [advisorId], references: [id])
  revisions           ProjectRevision[]

  @@index([advisorId, createdAt])
  @@index([status, createdAt])
}

// Immutable audit history for every initial analysis and reanalysis.
model ProjectRevision {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  revisionNumber     Int
  source             String   @default("reanalysis") // initial, reanalysis, legacy_backfill
  intakeSnapshot     String   // ProjectIntake JSON
  policyResult       String?
  grantsResult       String?
  coachResult        String?
  tradeoffsResult    String?
  enhanced           Boolean  @default(false)
  model              String?
  processingTimeMs   Int?

  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByAdvisorId String?
  createdByAdvisor   Advisor? @relation("ProjectRevisionCreatedBy", fields: [createdByAdvisorId], references: [id], onDelete: SetNull)

  @@unique([projectId, revisionNumber])
  @@index([projectId, createdAt])
  @@index([createdByAdvisorId])
}
