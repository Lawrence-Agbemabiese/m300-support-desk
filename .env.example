# Database (Railway PostgreSQL in production)
# In Railway, reference DATABASE_URL from the Postgres service. Use the same
# private connection for DIRECT_URL unless a separate migration URL is required.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# For local development with SQLite, change prisma/schema.prisma provider to "sqlite" and use:
# DATABASE_URL="file:./dev.db"

# Claude API Key (required for AI features)
ANTHROPIC_API_KEY=sk-ant-...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Secret for authentication (use a strong random string in production)
JWT_SECRET=your-secret-key-change-in-production

# Cron Secret for scheduled grant searches
CRON_SECRET=your-cron-secret-key

# Optional: Override default models
# CLAUDE_DEFAULT_MODEL=claude-sonnet-4-20250514
# CLAUDE_ENHANCED_MODEL=claude-opus-4-20250514
